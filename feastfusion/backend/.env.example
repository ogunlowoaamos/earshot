# FeastFusion backend configuration.
# Copy this file to `.env` and fill in what you have. Anything left
# blank is simply skipped — the site still works.

# --- Server ---------------------------------------------------------------
PORT=8080
DATABASE_URL=sqlite://data/feastfusion.db
UPLOAD_DIR=uploads

# --- Admin sign-in --------------------------------------------------------
# Used only on first start to create the admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=feastfusion123
JWT_SECRET=change-this-to-a-long-random-string

# --- Telegram notifications (optional) ------------------------------------
# 1. Message @BotFather, create a bot, copy the token.
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Cloud API notifications (optional) --------------------------
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TO=2348012345678

# --- Email notifications via Resend (optional) ----------------------------
RESEND_API_KEY=
MAIL_TO=you@example.com
MAIL_FROM=FeastFusion <onboarding@resend.dev>
